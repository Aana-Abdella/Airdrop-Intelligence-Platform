# Discord application credentials. Create these in the Discord Developer Portal.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: use a guild ID for immediate command registration during development.
DISCORD_GUILD_ID=

# Backend URL. Production deployments must use HTTPS.
API_BASE_URL=https://api.example.com

# Optional future scoped service credential. The current backend does not yet issue one.
# Never place a user password or broad administrator credential here.
API_KEY=

# Explicit local-development exception for API_BASE_URL=http://localhost:<port>.
ALLOW_INSECURE_LOCAL_API=false

# Logging verbosity: error, warn, info, or debug.
LOG_LEVEL=info

# development, test, or production.
NODE_ENV=development
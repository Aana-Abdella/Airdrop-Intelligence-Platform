# Discord application credentials. Create these in the Discord Developer Portal.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: use a guild ID for immediate command registration during development.
DISCORD_GUILD_ID=

# Backend URL. Production deployments must use HTTPS.
API_BASE_URL=http://127.0.0.1:8000

# Scoped service credential issued by the platform backend. Do not use a user JWT.
API_SERVICE_TOKEN=

# Public platform URL used for browser-based account linking and safe redirects.
PLATFORM_PUBLIC_URL=http://localhost:5173

# Optional comma-separated Discord guild IDs allowed to use this deployment.
ALLOWED_GUILD_IDS=

# Optional comma-separated role IDs allowed to use future administrative commands.
ADMIN_ROLE_IDS=

# Logging verbosity: error, warn, info, or debug.
LOG_LEVEL=info
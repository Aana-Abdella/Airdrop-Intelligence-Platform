# Airdrop Intelligence Platform backend
# Copy into your process environment; the backend does not load this file automatically.
# Use production only with a non-default AIP_SECRET_KEY.
AIP_ENVIRONMENT=development
AIP_SECRET_KEY=replace-with-a-long-random-secret
AIP_ACCESS_TOKEN_EXPIRE_MINUTES=30
AIP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AIP_DB_PATH=backend/aws.db
AIP_SCREENSHOT_PATH=backend/screenshots
# Optional override for the built React files served by FastAPI.
AIP_FRONTEND_DIST=frontend/dist
AIP_MAX_SCREENSHOT_BYTES=5242880
AIP_CLEANUP_HOURS=72

# Optional notification adapters. Leave blank to disable them.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=